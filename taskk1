
<!doctype html>
<html>
<head>
    </head>
    

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f2f2f2;
}

/* Navigation Bar */
nav {
    background-color: #222;
    color: white;
    padding: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
}

nav ul li {
    margin: 8px;
}

nav ul li a {
    color: white;
    text-decoration: none;
    padding: 8px;
    transition: 0.3s;
}

/* Interactive Navigation Effect */
nav ul li a:hover {
    color: yellow;
    background-color: #444;
    border-radius: 5px;
}

/* Common Section Styling */
section {
    padding: 40px;
    margin: 20px;
    text-align: center;
    background-color: white;
    border-radius: 10px;
    animation: fadeIn 1.5s;
}

/* Home Section */
#home {
    background-color: #dbeafe;
    padding: 80px 20px;
}

#home h1 {
    color: #1d4ed8;
}

/* Buttons */
.btn {
    display: inline-block;
    background-color: #2563eb;
    color: white;
    padding: 12px 20px;
    text-decoration: none;
    border-radius: 5px;
    transition: 0.3s;
}

.btn:hover {
    background-color: #1e3a8a;
    transform: scale(1.05);
}

/* Content Boxes */
.box {
    background-color: #e0f2fe;
    padding: 20px;
    margin: 15px auto;
    max-width: 500px;
    border-radius: 8px;
    transition: 0.3s;
}

.box:hover {
    transform: translateY(-5px);
    background-color: #bfdbfe;
}

/* CSS Animation */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Footer */
footer {
    background-color: #222;
    color: white;
    text-align: center;
    padding: 15px;
}

/* Responsive Layout */
@media screen and (max-width: 600px) {

    nav {
        flex-direction: column;
    }

    nav ul {
        flex-direction: column;
        padding: 0;
        text-align: center;
    }

    nav ul li {
        margin: 5px;
    }

    section {
        padding: 20px;
        margin: 10px;
    }

    .box {
        width: auto;
    }
}
