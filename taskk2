
<!DOCTYPE html>
<html>
<head>
    <title>Online Learning Platform</title>

    <style>

        /* Basic Styling */
        body {
            font-family: Arial, sans-serif;
            background-color: #f2f5f9;
            margin: 0;
            padding: 20px;
        }

        /* Main Heading */
        h1 {
            text-align: center;
            background-color: #172554;
            color: white;
            padding: 20px;
        }

        /* Course Categories */
        .categories {
            background-color: white;
            padding: 20px;
            margin: 20px auto;
            text-align: center;
            border-radius: 10px;
        }

        /* Course Cards */
        .course-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .course-card {
            background-color: white;
            width: 280px;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 3px 8px #cccccc;
            transition: 0.3s;
        }

        /* Card Hover Effect */
        .course-card:hover {
            transform: translateY(-5px);
        }

        /* Video Lesson Thumbnail */
        .thumbnail {
            background-color: #1e40af;
            color: white;
            height: 120px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 8px;
        }

        /* Buttons */
        button {
            background-color: #2563eb;
            color: white;
            padding: 12px 20px;
            border: none;
            border-radius: 5px;
            margin: 5px;
            cursor: pointer;
            transition: 0.3s;
        }

        button:hover {
            background-color: #172554;
        }

        /* Progress Indicators */
        progress {
            width: 100%;
            height: 15px;
        }

        /* Instructor Details */
        h3 {
            color: #1e40af;
        }

        /* Responsive Design */
        @media screen and (max-width: 600px) {

            body {
                padding: 5px;
            }

            .course-container {
                flex-direction: column;
                align-items: center;
            }

            .course-card {
                width: 85%;
            }

            button {
                max-width: 100%;
            }
        }

    </style>
</head>

<body>

    <h1>ONLINE LEARNING PLATFORM</h1>

    <!-- Course Categories -->
    <div class="categories">

        <h2>Course Categories</h2>

        <button>Web Development</button>
        <button>Python Programming</button>
        <button>Artificial Intelligence</button>
        <button>Data Science</button>

    </div>

    <h2 style="text-align:center;">Available Courses</h2>

    <div class="course-container">

        <!-- Course 1 -->
        <div class="course-card">

            <h2>Web Development</h2>

            <div class="thumbnail">
                ▶ Video Lesson 1
            </div>

            <h3>Instructor Profile</h3>
            <p>Name: John</p>
            <p>Expertise: Web Development</p>

            <h3>Course Description</h3>
            <p>Learn HTML, CSS and website development.</p>

            <h3>Learning Objectives</h3>
            <ul>
                <li>Learn HTML basics</li>
                <li>Understand CSS styling</li>
                <li>Create websites</li>
            </ul>

            <h3>Course Progress</h3>
            <progress value="40" max="100"></progress>
            <p>40% Completed</p>

            <button>Enroll Now</button>

        </div>

        <!-- Course 2 -->
        <div class="course-card">

            <h2>Python Programming</h2>

            <div class="thumbnail">
                ▶ Video Lesson 2
            </div>

            <h3>Instructor Profile</h3>
            <p>Name: David</p>
            <p>Expertise: Python Programming</p>

            <h3>Course Description</h3>
            <p>Learn Python programming from basic concepts.</p>

            <h3>Learning Objectives</h3>
            <ul>
                <li>Learn Python syntax</li>
                <li>Understand loops and conditions</li>
                <li>Write Python programs</li>
            </ul>

            <h3>Course Progress</h3>
            <progress value="60" max="100"></progress>
            <p>60% Completed</p>

            <button>Enroll Now</button>

        </div>

        <!-- Course 3 -->
        <div class="course-card">

            <h2>Artificial Intelligence</h2>

            <div class="thumbnail">
                ▶ Video Lesson 3
            </div>

            <h3>Instructor Profile</h3>
            <p>Name: Sarah</p>
            <p>Expertise: Artificial Intelligence</p>

            <h3>Course Description</h3>
            <p>Learn AI concepts and real-world applications.</p>

            <h3>Learning Objectives</h3>
            <ul>
                <li>Understand AI basics</li>
                <li>Learn machine learning</li>
                <li>Explore AI applications</li>
            </ul>

            <h3>Course Progress</h3>
            <progress value="25" max="100"></progress>
            <p>25% Completed</p>

            <button>Enroll Now</button>

        </div>

    </div>

</body>
</html>
