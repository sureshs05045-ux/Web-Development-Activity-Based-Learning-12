
<!DOCTYPE html>
<html>
<head>
    <title>Student Academic Dashboard</title>

    <style>

        /* Basic Styling */
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f2f5f9;
        }

        /* Sidebar */
        .sidebar {
            width: 220px;
            height: 100vh;
            background-color: #172554;
            color: white;
            position: fixed;
            padding: 20px;
            box-sizing: border-box;
        }

        .sidebar h2 {
            text-align: center;
        }

        .sidebar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 15px;
            margin: 5px 0;
            border-radius: 5px;
        }

        .sidebar a:hover {
            background-color: #2563eb;
        }

        /* Main Content */
        .main {
            margin-left: 240px;
            padding: 20px;
        }

        h1 {
            color: #172554;
        }

        /* Student Details Card */
        .student-card {
            background-color: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 3px 8px #cccccc;
        }

        /* Dashboard Cards */
        .card-container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 20px;
        }

        .card {
            background-color: white;
            padding: 20px;
            width: 180px;
            border-radius: 10px;
            box-shadow: 0 3px 8px #cccccc;
            flex: 1;
        }

        .card h3 {
            color: #2563eb;
        }

        /* Tables */
        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
            margin-top: 15px;
        }

        th, td {
            border: 1px solid #cccccc;
            padding: 12px;
            text-align: center;
        }

        th {
            background-color: #172554;
            color: white;
        }

        /* Progress Bars */
        progress {
            width: 100%;
            height: 15px;
        }

        /* Announcements */
        .announcement {
            background-color: white;
            padding: 15px;
            margin: 10px 0;
            border-left: 5px solid #2563eb;
            border-radius: 5px;
        }

        /* Hover Effect */
        .card:hover {
            transform: translateY(-5px);
            transition: 0.3s;
        }

        /* Responsive Design */
        @media screen and (max-width: 700px) {

            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
            }

            .sidebar a {
                display: inline-block;
                padding: 10px;
            }

            .main {
                margin-left: 0;
                padding: 10px;
            }

            .card-container {
                flex-direction: column;
            }

            .card {
                width: auto;
            }

            table {
                font-size: 12px;
            }
        }

    </style>
</head>

